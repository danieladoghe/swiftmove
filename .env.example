# Copy this file to .env.local for local dev, and set the same variables in
# Netlify → Site settings → Environment variables for production.
# NEVER commit real tokens to the repository.

# Square (storage reservation invoices + future shop payments)
# SQUARE_ENV: "sandbox" while testing, "production" when you go live.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_SQUARE_APP_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://www.mosyard.ca

# Transactional email (future: contact/quote notifications to info@mosyard.ca)
# RESEND_API_KEY=
