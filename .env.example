# Copy this file to .env.local for local dev, and set the same variables in
# Netlify → Site settings → Environment variables for production.
# NEVER commit real tokens to the repository.

# Square (storage reservation invoices + future shop payments)
# SQUARE_ENV: "sandbox" while testing, "production" when you go live.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_SQUARE_APP_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://www.mosyard.ca

# ── Transactional email ──────────────────────────────────────────────────────
# Every form (orders, reservations, freight quotes, enquiries) emails a
# notification here. Create a Resend account, add + verify the mosyard.ca domain,
# then paste the API key. Until the domain is verified you can test with
# EMAIL_FROM="Mo's Yard <onboarding@resend.dev>" (Resend's shared sender).
RESEND_API_KEY=
EMAIL_FROM=Mo's Yard <notifications@mosyard.ca>
EMAIL_TO=info@mosyard.ca

# ── Admin dashboard database (Postgres) ──────────────────────────────────────
# Every submission is logged here and shown at /admin. Works with any Postgres —
# Neon or Supabase both have free tiers. Use the pooled/serverless connection
# string. Set DATABASE_SSL=disable only for a local non-SSL Postgres.
DATABASE_URL=
# DATABASE_SSL=disable

# ── Admin login (/admin) ─────────────────────────────────────────────────────
# AUTH_SECRET: a long random string (e.g. `openssl rand -hex 32`).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SECRET=
